---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda banda--papel prueba error-pagina">
    <div class="contenedor error-rejilla">
      <p class="error-cifra guias" aria-hidden="true">404</p>
      <div class="titular">
        <p class="antetitulo">Página no encontrada</p>
        <h1 class="titulo-seccion">Este rincón no está en la exposición</h1>
        <p class="entrada">Puede que el enlace esté mal o que la página se haya movido. Vuelve al inicio y sigue mirando.</p>
        <div class="botones">
          <a class="btn" href="/">Volver al inicio</a>
        </div>
      </div>
    </div>
  </section>
</Base>
