---
// Cabecera «estudio»: fija arriba, a todo el ancho, sobre la hoja de pruebas (papel frío con retícula de puntos y grano).
// Nombre en Hedvig Letters Serif a la izquierda, enlaces en Geist con subrayado naranja al pasar y el botón impreso
// (relleno naranja, filete interior y marcas de corte) a la derecha. Al bajar, el filete inferior pasa a tinta.
// En móvil, menú plegable con <details>. Va por encima de la portada (z-index 50). Aspecto: .cabecera--estudio.
import { site } from '../data/site';
import type { Enlace } from '../data/site';
interface Props { variante?: string; cta?: Enlace | null }
const { variante = 'estudio', cta = null } = Astro.props;
---

<header class={`cabecera cabecera--${variante} prueba prueba--fija`} data-cabecera>
  <div class="contenedor cabecera-fila">
    <a href="/" class="marca" aria-label={`${site.nombre}, inicio`}>
      {
        site.logo ? (
          <img src={site.logo} alt={site.nombre} class="marca-logo" width="160" height="40" />
        ) : (
          <span class="marca-nombre">{site.nombre}</span>
        )
      }
    </a>
    <nav class="cabecera-nav" aria-label="Menú principal">
      {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
    </nav>
    {cta && cta.url && <a href={cta.url} class="btn cabecera-cta">{cta.texto}</a>}
    {
      site.menu.length > 0 && (
        <details class="menu-movil">
          <summary>
            <span class="menu-movil-icono" aria-hidden="true" />
            <span>Menú</span>
          </summary>
          <nav class="menu-movil-panel" aria-label="Menú">
            {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
            {cta && cta.url && <a href={cta.url} class="btn">{cta.texto}</a>}
          </nav>
        </details>
      )
    }
  </div>
</header>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.menu-movil a').forEach(function (a) {
      a.addEventListener('click', function () { a.closest('details').open = false; });
    });
    var cabecera = document.querySelector('[data-cabecera]');
    if (!cabecera) return;
    function revisar() { cabecera.classList.toggle('con-filete', window.scrollY > 16); }
    revisar();
    window.addEventListener('scroll', revisar, { passive: true });
  });
</script>
